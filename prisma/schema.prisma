// GigSure AI — Prisma schema
// Work with confidence. Get paid with trust.
//
// Design notes:
// - Database: SQLite (local MVP). Production should swap to PostgreSQL — see DEPLOYMENT_GUIDE.md.
// - Financial values are stored as Integer minor units (e.g., NGN kobo) to avoid binary
//   floating-point rounding errors. Currency codes are stored as ISO 4217 strings.
// - Enums are stored as String with server-side validation (SQLite has no native ENUM).
// - All timestamps are UTC (DateTime).
// - Soft-delete columns (`deletedAt`) are used where data must be retained for legal/audit reasons.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTHENTICATION & IDENTITY
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailNormalized String   @unique
  displayName     String
  passwordHash    String?
  emailVerifiedAt DateTime?
  accountStatus   String   @default("ACTIVE") // ACTIVE | SUSPENDED | PENDING_DELETION | DELETED
  platformRole    String   @default("USER") // USER | ADMIN
  lastLoginAt     DateTime?
  // SECURITY: when set, any JWT with issuedAt < passwordChangedAt is rejected
  // (forces re-auth after password change/reset)
  passwordChangedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  identities        UserIdentity[]
  sessions          Session[]
  emailVerifications EmailVerificationToken[]
  passwordResets    PasswordResetToken[]
  profile           UserProfile?
  preferences       UserPreferences?
  auditEvents       AuditEvent[]       @relation("AuditActor")
  projectsOwned     Project[]           @relation("ProjectOwner")
  projectsClient    Project[]           @relation("ProjectClient")
  memberships       ProjectMembership[]
  invitationsSent   Invitation[]       @relation("InvitationInviter")
  invitationsReceived Invitation[]      @relation("InvitationInvitee")
  tasksAssigned     Task[]              @relation("TaskAssignee")
  deliverables      Deliverable[]
  contractAcceptances ContractAcceptance[]
  compensationAcceptances CompensationAcceptance[]
  disputesOpened    Dispute[]           @relation("DisputeOpener")
  disputeReviews    DisputeReview[]
  notifications     Notification[]
  privacyRequests   PrivacyRequest[]
  aiActivities      AiActivity[]
  fundingInitiated  FundingRecord[]     @relation("FundingInitiator")
  linkedAccounts    LinkedAccount[]
  revokedSessions   RevokedSession[]
  kycVerifications  KycVerification[]
  paymentTransactions PaymentTransaction[]
  bankDetails      BankDetail[]
  payoutsReceived  Payout[]            @relation("PayoutPayee")
  payoutsInitiated Payout[]            @relation("PayoutInitiator")
  expensesRequested ProjectExpense[]   @relation("ExpenseRequester")
  expensesApproved  ProjectExpense[]   @relation("ExpenseApprover")
}

model UserIdentity {
  // External identity mapping (Google OIDC "sub", future providers).
  // One User can have many UserIdentities; each (provider, providerSubject)
  // pair is unique — this is what enables "one account, multiple auth methods".
  id                 String   @id @default(cuid())
  userId             String
  provider           String   // "google" | "password" | "github" | "microsoft" | "apple"
  providerSubject    String   // OIDC "sub" for OAuth providers; email for password
  createdAt          DateTime @default(now())
  lastAuthenticatedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model LinkedAccount {
  // OAuth tokens for providers (used for account linking workflow).
  // NOTE: refresh tokens are NOT stored unless a documented feature requires them.
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerSubject String
  linkedAt       DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  csrfToken    String
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // store SHA-256 hash, never the raw token
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// PROFILES & PREFERENCES
// ---------------------------------------------------------------------------

model UserProfile {
  userId              String   @id
  headline            String?
  bio                 String?
  country             String?
  region              String?
  preferredLanguage   String   @default("en")
  timezone            String   @default("Africa/Lagos")
  professionalRole    String?
  skills              String   // JSON-encoded array
  specialization      String?
  portfolioLinks      String   // JSON-encoded array
  availability        String   @default("OPEN") // OPEN | BUSY | UNAVAILABLE
  preferredCategories String   // JSON-encoded array
  profileImageMime    String?
  profileImageBytes   Int      @default(0)
  profileVisibility   String   @default("PRIVATE") // PRIVATE | TEAM | PUBLIC
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  userId               String   @id
  preferredCurrency    String   @default("NGN")
  emailNotifications   Boolean  @default(true)
  pushNotifications    Boolean  @default(true)
  marketingEmails      Boolean  @default(false)
  aiFeatureDisclosure Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// PROJECTS & CONTRACTS
// ---------------------------------------------------------------------------

model Project {
  id                String   @id @default(cuid())
  ownerId           String
  clientId          String?  // can be self or another user
  title             String
  slug              String   @unique
  description       String
  status            String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | COMPLETED | CANCELLED
  startDate         DateTime?
  dueDate           DateTime?
  currency          String   @default("NGN")
  budgetMinor       Int      @default(0) // budget in minor units
  fundingArrangement String  @default("MILESTONE") // FULL | MILESTONE | UPFRONT_PLUS_MILESTONES
  currentContractVersionId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner            User               @relation("ProjectOwner", fields: [ownerId], references: [id])
  client           User?              @relation("ProjectClient", fields: [clientId], references: [id])
  memberships      ProjectMembership[]
  invitations      Invitation[]
  contracts        ContractVersion[]
  tasks            Task[]
  milestones       Milestone[]
  fundingRecords   FundingRecord[]
  disputes         Dispute[]
  auditEvents      AuditEvent[]
  notifications    Notification[]
  aiActivities     AiActivity[]
  paymentTransactions PaymentTransaction[]
  payouts          Payout[]
  virtualAccounts  VirtualAccount[]
  expenses         ProjectExpense[]

  @@index([ownerId])
  @@index([clientId])
}

model ProjectMembership {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   // OWNER | CLIENT | COLLABORATOR | TEAM_LEAD | REVIEWER
  joinedAt  DateTime @default(now())
  revokedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Invitation {
  id          String   @id @default(cuid())
  projectId   String
  inviteeId   String?  // optional: bound to a specific user
  inviteeEmail String?
  inviterId   String
  role        String   // COLLABORATOR | TEAM_LEAD | REVIEWER
  tokenHash   String   @unique // cryptographically random, hashed
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | REVOKED | EXPIRED
  expiresAt   DateTime
  consumedAt   DateTime?
  createdAt   DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitee  User?   @relation("InvitationInvitee", fields: [inviteeId], references: [id])
  inviter  User    @relation("InvitationInviter", fields: [inviterId], references: [id])

  @@index([projectId])
  @@index([inviteeId])
}

model ContractVersion {
  id              String   @id @default(cuid())
  projectId       String
  versionNumber   Int
  scopeOfWork     String
  deliverables    String   // JSON-encoded array
  deadlines       String
  paymentSchedule String
  milestoneConditions String
  revisionRules   String
  cancellationTerms String
  disputeProcedures String
  status          String   @default("DRAFT") // DRAFT | PROPOSED | ACCEPTED | SUPERSEDED | CANCELLED
  createdById     String
  createdAt       DateTime @default(now())
  supersededAt    DateTime?

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  acceptances ContractAcceptance[]

  @@unique([projectId, versionNumber])
  @@index([projectId])
}

model ContractAcceptance {
  id              String   @id @default(cuid())
  contractVersionId String
  userId          String
  acceptedAt      DateTime @default(now())
  acceptanceIp    String?

  contractVersion ContractVersion @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contractVersionId, userId])
}

// ---------------------------------------------------------------------------
// TASKS & DELIVERABLES
// ---------------------------------------------------------------------------

model Task {
  id          String   @id @default(cuid())
  projectId   String
  milestoneId String?
  assigneeId  String?
  title       String
  description String?
  status      String   @default("TODO") // TODO | IN_PROGRESS | SUBMITTED | CHANGES_REQUESTED | APPROVED | CANCELLED
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  dueDate     DateTime?
  dependsOn   String   // JSON-encoded array of task IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  milestone    Milestone?   @relation(fields: [milestoneId], references: [id])
  deliverables Deliverable[]

  @@index([projectId])
  @@index([assigneeId])
}

model Deliverable {
  id          String   @id @default(cuid())
  taskId      String
  submitterId String
  filename    String
  contentType String
  sizeBytes   Int
  storageKey  String   // private storage key, never publicly accessible
  status      String   @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | CHANGES_REQUESTED | REJECTED
  reviewerId  String?
  reviewNote  String?
  submittedAt DateTime @default(now())
  reviewedAt  DateTime?

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submitter User @relation(fields: [submitterId], references: [id])

  @@index([taskId])
}

// ---------------------------------------------------------------------------
// COMPENSATION AGREEMENTS
// ---------------------------------------------------------------------------

model CompensationAgreement {
  id          String   @id @default(cuid())
  projectId   String
  versionNumber Int
  totalDistributableMinor Int // total amount to distribute
  currency    String
  status      String   @default("DRAFT") // DRAFT | PROPOSED | ACCEPTED | SUPERSEDED
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  supersededAt DateTime?

  // NOTE: stored separately — projectId is implicit through allocations in current schema,
  // but we keep projectId here for direct queries.
  allocations CompensationAllocation[]
  acceptances CompensationAcceptance[]

  @@unique([projectId, versionNumber])
  @@index([projectId])
}

model CompensationAllocation {
  id                       String @id @default(cuid())
  compensationAgreementId  String
  userId                   String
  role                     String
  amountMinor              Int
  percentageBps            Int // basis points (1% = 100 bps)
  notes                    String?

  agreement CompensationAgreement @relation(fields: [compensationAgreementId], references: [id], onDelete: Cascade)

  @@index([compensationAgreementId])
  @@index([userId])
}

model CompensationAcceptance {
  id                      String   @id @default(cuid())
  compensationAgreementId String
  userId                  String
  acceptedAt              DateTime @default(now())

  agreement CompensationAgreement @relation(fields: [compensationAgreementId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id])

  @@unique([compensationAgreementId, userId])
}

// ---------------------------------------------------------------------------
// MILESTONES & FUNDING
// ---------------------------------------------------------------------------

model Milestone {
  id           String   @id @default(cuid())
  projectId    String
  title        String
  description  String?
  amountMinor  Int
  dueDate      DateTime?
  status       String   @default("DRAFT") // DRAFT | AWAITING_FUNDING | FUNDED | SUBMITTED | APPROVED | RELEASE_INITIATED | RELEASED | DISPUTED | REFUNDED | FAILED | CANCELLED
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks          Task[]
  fundingRecords FundingRecord[]
  disputes       Dispute[]
  paymentTransactions PaymentTransaction[]
  payouts        Payout[]
  virtualAccounts VirtualAccount[]
  expenses       ProjectExpense[]

  @@index([projectId])
}

model FundingRecord {
  id                String   @id @default(cuid())
  projectId        String
  milestoneId      String?
  type              String   // FUNDING | RELEASE | REFUND
  amountMinor       Int
  currency          String
  status            String   // DRAFT | INITIATED | PROVIDER_CONFIRMED | PARTIALLY_CONFIRMED | FAILED | CANCELLED | DISPUTED
  provider          String   @default("mock")
  providerTxRef      String?  @unique // unique provider reference for idempotency
  idempotencyKey    String?  @unique
  initiatedById     String
  initiatedAt       DateTime @default(now())
  confirmedAt       DateTime?
  failureReason     String?
  isSimulated       Boolean  @default(false) // retained for historical audit; new records are always real

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone     Milestone?      @relation(fields: [milestoneId], references: [id])
  initiatedBy   User            @relation("FundingInitiator", fields: [initiatedById], references: [id])
  webhookEvents WebhookEvent[]
  auditEvents   AuditEvent[]
  expenses      ProjectExpense[]

  @@index([projectId])
  @@index([milestoneId])
}

// ---------------------------------------------------------------------------
// PROJECT EXPENSES — service provider requests funds from already-funded milestone
// ---------------------------------------------------------------------------

model ProjectExpense {
  // Service provider requests a partial release of milestone funds for
  // project-related expenses (domain, hosting, software licenses, etc.).
  // The milestone must already be FUNDED — the money is already held in
  // GigSure Payment Protection. The expense request is a request to release
  // a portion of those funds to the service provider before the milestone
  // is completed.
  id              String   @id @default(cuid())
  projectId       String
  milestoneId     String
  requestedById   String   // service provider who needs the money
  approvedById    String?  // client who approved (null until approved)

  title           String   // e.g., "Domain and hosting"
  description     String?  // breakdown of what the money is for
  category        String   // DOMAIN_HOSTING | SOFTWARE_LICENSE | STOCK_ASSETS | THIRD_PARTY_SERVICES | HARDWARE | OTHER
  amountMinor     Int      // amount requested
  currency        String   @default("NGN")

  // State machine: REQUESTED → APPROVED → RELEASED | REJECTED | DISPUTED
  status          String   @default("REQUESTED")
  rejectionReason String?
  receiptUrl      String?  // uploaded by service provider after spending (proof of purchase)
  receiptUploadedAt DateTime?

  // Links to the funding record created when the expense is released
  fundingRecordId String?  @unique
  payoutId        String?  // link to the Payout record when money is sent

  createdAt       DateTime @default(now())
  approvedAt      DateTime?
  releasedAt      DateTime?
  updatedAt       DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone       Milestone        @relation(fields: [milestoneId], references: [id])
  requestedBy     User             @relation("ExpenseRequester", fields: [requestedById], references: [id])
  approvedBy      User?            @relation("ExpenseApprover", fields: [approvedById], references: [id])
  fundingRecord   FundingRecord?   @relation(fields: [fundingRecordId], references: [id])
  auditEvents     AuditEvent[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([requestedById])
  @@index([status])
}

// ---------------------------------------------------------------------------
// DISPUTES & EVIDENCE
// ---------------------------------------------------------------------------

model Dispute {
  id          String   @id @default(cuid())
  projectId   String
  openedById  String
  milestoneId String?
  category    String   // QUALITY | DEADLINE | PAYMENT | SCOPE | CONDUCT | OTHER
  title       String
  description String
  status      String   @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | ESCALATED | CLOSED
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  closedAt    DateTime?

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opener    User             @relation("DisputeOpener", fields: [openedById], references: [id])
  milestone Milestone?       @relation(fields: [milestoneId], references: [id])
  evidence  DisputeEvidence[]
  messages  DisputeMessage[]
  reviews   DisputeReview[]

  @@index([projectId])
}

model DisputeEvidence {
  id          String   @id @default(cuid())
  disputeId   String
  uploadedById String
  filename    String
  contentType String
  sizeBytes   Int
  storageKey  String
  description String?
  uploadedAt  DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
}

model DisputeMessage {
  id        String   @id @default(cuid())
  disputeId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
}

model DisputeReview {
  id          String   @id @default(cuid())
  disputeId   String
  reviewerId  String
  note        String?
  proposedResolution String?
  outcome     String?  // UPHOLD_CLAIM | REJECT_CLAIM | PARTIAL | ESCALATE
  decidedAt   DateTime?
  createdAt   DateTime @default(now())

  dispute  Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id])

  // SECURITY: prevent duplicate reviews by same reviewer on same dispute
  // Required by /api/projects/[id]/disputes/[disputeId]/reviews POST (upsert)
  @@unique([disputeId, reviewerId])
  @@index([disputeId])
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS, AUDIT, WEBHOOKS, AI, PRIVACY
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  projectId  String?
  fundingRecordId String?
  payoutId        String?
  expenseId       String?
  action     String
  targetType String?
  targetId   String?
  metadata   String   // JSON-encoded
  ipAddress  String?
  // SECURITY (2026-10): hash chain for tamper-evidence.
  // previousHash = eventHash of the immediately preceding AuditEvent (or
  // "genesis" for the first event). eventHash = sha256(previousHash + canonicalJson(eventData)).
  // An attacker who modifies any event breaks the chain — detectable by
  // recomputing hashes from the genesis forward.
  previousHash String?
  eventHash    String?  @unique
  createdAt  DateTime @default(now())

  actor        User?          @relation("AuditActor", fields: [actorId], references: [id])
  project      Project?       @relation(fields: [projectId], references: [id])
  fundingRecord FundingRecord? @relation(fields: [fundingRecordId], references: [id])
  payout       Payout?        @relation(fields: [payoutId], references: [id])
  expense      ProjectExpense? @relation(fields: [expenseId], references: [id])

  @@index([actorId])
  @@index([projectId])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String   @default("mock")
  eventType       String
  providerEventId String?  @unique // for replay protection
  signatureValid  Boolean  @default(false)
  payload         String   // JSON
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  fundingRecordId String?
  paymentTransactionId String?
  payoutId        String?
  virtualAccountId String?

  fundingRecord FundingRecord? @relation(fields: [fundingRecordId], references: [id])
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  payout        Payout?        @relation(fields: [payoutId], references: [id])
  virtualAccount VirtualAccount? @relation(fields: [virtualAccountId], references: [id])

  @@index([providerEventId])
}

model AiActivity {
  id            String   @id @default(cuid())
  userId        String
  projectId     String?
  assistantType String   // TEAM_PLANNER | TASK_PLANNER | CONTRACT | FUNDING | RISK | EVIDENCE | PROGRESS
  prompt        String
  response      String
  modelId       String?
  tokensUsed    Int      @default(0)
  fallbackUsed  Boolean  @default(false)
  createdAt     DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([projectId])
}

model PrivacyRequest {
  id          String   @id @default(cuid())
  userId      String
  type        String   // EXPORT | DELETE
  status      String   @default("PENDING") // PENDING | PROCESSING | READY | COMPLETED | DENIED
  result      String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// SESSION REVOCATION (2026-10)
// ---------------------------------------------------------------------------
// When a user revokes a specific session (e.g., "I lost my phone, sign that out"),
// the session's jti is recorded here. The NextAuth jwt callback checks this
// table on every request and invalidates any JWT whose jti appears.
//
// This enables per-session revocation without the all-or-nothing approach of
// passwordChangedAt (which logs out ALL sessions).
// ---------------------------------------------------------------------------

model RevokedSession {
  id        String   @id @default(cuid())
  jti       String   @unique  // JWT ID — unique per session
  userId    String
  reason    String?  // "user_revoked" | "admin_revoked" | "password_change"
  userAgent String?
  ipAddress String?
  revokedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// KYC VERIFICATION (2026-10)
// ---------------------------------------------------------------------------
// Stores NIN + selfie liveness verification results from Smile ID (or mock).
// Users must complete KYC before participating in funding transactions.
// ---------------------------------------------------------------------------

model KycVerification {
  id              String   @id @default(cuid())
  userId          String
  status          String   @default("PENDING") // PENDING | IN_PROGRESS | VERIFIED | REJECTED | EXPIRED
  provider        String   @default("mock") // "smile_id" | "mock"
  providerJobId   String?  @unique // Smile ID job ID for polling
  ninNumber       String   // National Identification Number (hashed for storage)
  ninNumberLast4  String   // last 4 digits for display (e.g., "****1234")
  fullName        String   // full name as returned by NIN lookup
  verificationType String  @default("NIN_WITH_LIVENESS") // "NIN_LOOKUP" | "NIN_WITH_LIVENESS"
  
  // Verification results
  selfieMatch     Boolean?  // did selfie match NIN photo?
  livenessPassed  Boolean?  // did liveness check pass?
  confidenceScore Float?   // 0-100, smile ID confidence
  
  // Failure details
  failureReason   String?
  
  // Metadata
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  verifiedAt      DateTime?
  expiresAt       DateTime? // KYC expires after 1 year
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// PAYMENT LEDGER (2026-10)
// ---------------------------------------------------------------------------
// Append-only financial ledger for all payment-related events.
// Every payment, fee, refund, and settlement has an immutable entry here.
// Corrections use linked reversal entries, not edits to historical records.
// ---------------------------------------------------------------------------

model PaymentTransaction {
  id              String   @id @default(cuid())
  projectId       String
  milestoneId     String?
  userId          String  // who initiated
  paymentReference String  @unique  // internal unique reference (e.g., GS_pay_xxx)
  provider        String   // "mock" | "monnify" | "opay"
  providerReference String? // provider's transaction reference
  amountMinor     Int      // total payment amount
  currency        String   @default("NGN")
  status          String   @default("CREATED") // PaymentState enum
  feeMinor        Int      @default(0)  // platform fee
  netMinor        Int      @default(0)  // net amount after fee
  feePolicyVersion String?  // policy version used for fee calc
  feeRateBps     Int      @default(150) // fee rate in basis points
  paymentMethod  String?  // "card" | "transfer" | "ussd"
  checkoutUrl    String?  // hosted checkout URL
  redirectUrl    String?  // post-payment redirect
  customerEmail  String?
  customerName   String?
  description    String?
  metadata       String   @default("{}") // JSON-encoded
  
  // Timing
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  
  // Relations
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      Milestone? @relation(fields: [milestoneId], references: [id])
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries  LedgerEntry[]
  webhookEvents  WebhookEvent[]
  
  @@index([projectId])
  @@index([userId])
  @@index([providerReference])
}

model LedgerEntry {
  id              String   @id @default(cuid())
  transactionId   String
  entryType       String   // PAYMENT | FEE | REFUND | FEE_REVERSAL | SETTLEMENT | ADJUSTMENT
  amountMinor     Int      // positive = credit, negative = debit
  currency        String   @default("NGN")
  description     String?
  accountType     String   // "PROVIDER_CLEARING" | "PROJECT_LIABILITY" | "PLATFORM_FEE_REVENUE" | "REFUND" | "PAYOUT"
  reversalOfId    String?  // if this is a reversal, link to original entry
  
  createdAt       DateTime @default(now())
  
  transaction     PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  @@index([transactionId])
  @@index([accountType])
}

model PaymentSettings {
  id                  String   @id @default("singleton")
  feeRateBps          Int      @default(150)
  livePaymentsEnabled Boolean  @default(false)
  livePayoutsEnabled  Boolean  @default(false)
  defaultProvider     String   @default("monnify")
  
  // Monnify
  monnifyEnabled      Boolean  @default(false)
  monnifyEnvironment  String   @default("sandbox")
  monnifyApiKey       String   @default("")
  monnifySecretKey    String   @default("")
  monnifyContractCode  String   @default("")
  
  // OPay
  opayEnabled         Boolean  @default(false)
  opayEnvironment     String   @default("sandbox")
  opayMerchantId      String   @default("")
  opayPublicKey       String   @default("")
  opayPrivateKey      String   @default("")
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// BANKS, BANK DETAILS, PAYOUTS, VIRTUAL ACCOUNTS
// ---------------------------------------------------------------------------

model Bank {
  // List of supported banks (fetched from Monnify / OPay and cached).
  // Used to populate the worker bank-detail form's bank dropdown.
  id           String   @id @default(cuid())
  code         String   @unique // provider-specific bank code (e.g., "044" for Access Bank)
  name         String   // "Access Bank Nigeria"
  shortName    String?  // "Access"
  provider     String   // "monnify" | "opay" | "universal"
  isActive     Boolean  @default(true)
  fetchedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bankDetails  BankDetail[]

  @@index([provider])
}

model BankDetail {
  // Worker's payout bank account. Required before any payout can be initiated.
  // One user can have multiple bank accounts but only one "isDefault" payout
  // destination per currency. Account name must match KYC name to reduce
  // payout fraud risk.
  id              String   @id @default(cuid())
  userId          String
  accountName     String   // must match KYC name (validated server-side)
  accountNumber   String   // 10-digit NUBAN
  bankCode        String   // links to Bank.code
  bankName        String   // denormalized for display without JOIN
  currency        String   @default("NGN")
  isDefault       Boolean  @default(false)
  isVerified      Boolean  @default(false) // resolved via name enquiry
  verifiedAt      DateTime?
  verificationRef String?  // provider's name-enquiry reference
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank            Bank?    @relation(fields: [bankCode], references: [code])
  payouts         Payout[]

  @@unique([userId, accountNumber, bankCode]) // no duplicate accounts
  @@index([userId])
}

model Payout {
  // Disbursement record: platform → worker's bank account.
  // Created when a milestone is RELEASED (or a manual admin payout).
  // State mirrors PaymentState but with payout-specific labels.
  id                String   @id @default(cuid())
  payoutReference   String   @unique // internal unique reference (e.g., GS_payout_xxx)
  projectId         String
  milestoneId       String?
  payeeId           String   // worker who receives the money
  initiatedById     String   // who triggered the release (owner or admin)

  provider          String   @default("mock") // "mock" | "monnify" | "opay"
  providerReference String?  @unique // provider's transfer reference

  // Amounts (stored in integer minor units, consistent with FundingRecord)
  amountMinor       Int      // gross amount being paid out (after fee deducted from project side)
  feeMinor          Int      @default(0) // platform fee already taken at inbound
  netMinor          Int      @default(0) // amount that lands in worker's account
  currency          String   @default("NGN")

  // Payout bank destination (snapshot at time of initiation — immutable)
  bankDetailId      String?
  payeeAccountName  String
  payeeAccountNumber String
  payeeBankCode     String
  payeeBankName     String

  // State machine: PENDING → SUCCEEDED | FAILED | REVERSED
  status            String   @default("PENDING") // PENDING | SUCCEEDED | FAILED | REVERSED
  failureReason     String?
  idempotencyKey    String?  @unique

  initiatedAt       DateTime @default(now())
  settledAt         DateTime?
  failedAt          DateTime?
  reversedAt        DateTime?
  updatedAt         DateTime @updatedAt

  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone         Milestone?       @relation(fields: [milestoneId], references: [id])
  payee             User             @relation("PayoutPayee", fields: [payeeId], references: [id])
  initiatedBy       User             @relation("PayoutInitiator", fields: [initiatedById], references: [id])
  bankDetail        BankDetail?      @relation(fields: [bankDetailId], references: [id])
  webhookEvents     WebhookEvent[]
  auditEvents       AuditEvent[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([payeeId])
  @@index([status])
}

model VirtualAccount {
  // Per-project (or per-milestone) reserved bank account generated by Monnify.
  // The client transfers money into this account number to fund the project.
  // Funds settle into the platform's Monnify wallet and are credited to the
  // project's FundingRecord when the webhook confirms receipt.
  id                String   @id @default(cuid())
  projectId         String
  milestoneId       String?

  provider          String   @default("monnify") // "mock" | "monnify"
  providerAccountRef String? @unique // Monnify reserved account reference
  accountNumber     String   // 10-digit NUBAN the client transfers to
  accountName       String   // "GigSure/Gigsure-<projectSlug>" (Monnify format)
  bankName          String
  bankCode          String

  // Lifecycle: ACTIVE → the client can still send money; DEALLOCATED → no longer usable.
  status            String   @default("ACTIVE") // ACTIVE | DEALLOCATED | EXPIRED
  expiresAt         DateTime? // Monnify reserved accounts can be set to expire

  // Track how much has been received into this account so far
  totalReceivedMinor Int     @default(0)
  expectedAmountMinor Int?   // if bound to a single milestone amount

  createdAt         DateTime @default(now())
  deallocatedAt     DateTime?
  updatedAt         DateTime @updatedAt

  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone         Milestone?       @relation(fields: [milestoneId], references: [id])
  webhookEvents     WebhookEvent[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([accountNumber])
}

