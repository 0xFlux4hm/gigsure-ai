DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-only-secret-please-rotate-in-production-7f3a9c2e1b8d4f6a

# Google OAuth — real credentials required for production Google sign-in.
# If absent or starting with "demo_", a simulated Google flow is used.
GOOGLE_CLIENT_ID=demo_placeholder
GOOGLE_CLIENT_SECRET=demo_placeholder

# Mock payment provider (webhook signing secret).
# NEVER reuse in production. Real providers (Paystack, Flutterwave) document their own schemes.
MOCK_WEBHOOK_SECRET=mock-webhook-secret-dev-only

# Email provider (SMTP URL for verification/reset emails). Optional in dev.
EMAIL_FROM="GigSure AI <noreply@localhost>"
# SMTP_URL=smtp://user:pass@smtp.example.com:587
